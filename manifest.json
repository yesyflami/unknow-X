{
  "manifest_version": 3,
  "name": "unknow-X",
  "version": "1.1.0",
  "description": "Customize the visible name and ID in X's lower-left account switcher while keeping account switching usable.",
  "permissions": ["storage"],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
